{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        
        "next",
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "@typescript-eslint"
    ],
    "rules": {
        "indent": [
            "error",
            2
        ],
        "max-len": [
            "warn",
            {
              "code": 100
            }
          ],
        "quotes": [
            "error",
            "single"
        ],
        "linebreak-style": [
            "warn",
            "unix"
          ],
        "semi": [
            "error",
            "always"
        ],
        "no-unused-vars": [
            "warn",
            {
              "varsIgnorePattern": "^_",
              "argsIgnorePattern": "^_"
            }
          ]
    }
}