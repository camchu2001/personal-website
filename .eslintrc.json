{
  "extends": [
    "next",
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "indent": [
      "error",
      2
    ],
    "max-len": [
      "warn",
      {
        "code": 100
      }
    ],
    "quotes": [
      "error",
      "single"
    ],
    "linebreak-style": [
      "warn",
      "unix"
    ],
    "semi": [
      "error",
      "always"
    ],
    "no-unused-vars": [
      "warn",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ]
  }
}